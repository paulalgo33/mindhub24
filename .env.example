# MindHub24 — Booking automation env vars
# Set ALL of these in Vercel → Project → Settings → Environment Variables
# (NOT committed — this is just the template)

# --- Supabase ---
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...        # Supabase → Settings → API → service_role (secret!)

# --- Resend (email) ---
RESEND_API_KEY=re_...                   # resend.com → API Keys

# --- Telegram ---
TELEGRAM_BOT_TOKEN=123456:ABC...        # from @BotFather
TELEGRAM_INTERNAL_CHAT_IDS=111111,222222  # Alexandra's + Sudipto's chat IDs, comma-separated

# --- Cron guard ---
CRON_SECRET=some-long-random-string     # protects /api/dispatch-due from public triggering

# --- Existing (already set, for AI tools) ---
# ANTHROPIC_API_KEY=sk-ant-...
